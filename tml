<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1, user-scalable=no">
<title>Oficina do Negão</title>
<link rel="manifest" href="data:application/manifest+json,{&quot;name&quot;:&quot;Oficina do Neg%C3%A3o&quot;,&quot;short_name&quot;:&quot;Oficina&quot;,&quot;start_url&quot;:&quot;.&quot;,&quot;display&quot;:&quot;standalone&quot;,&quot;background_color&quot;:&quot;%2315171c&quot;,&quot;theme_color&quot;:&quot;%23f2a93b&quot;}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#15171c;
    --bg-elev:#1c1f26;
    --bg-elev2:#242833;
    --line:#31353f;
    --text:#e9ebef;
    --text-dim:#9298a6;
    --amber:#f2a93b;
    --amber-dim:#3a2f1c;
    --blue:#5b8ca8;
    --red:#d9584f;
    --green:#5fa876;
    --radius:10px;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:var(--bg);
    color:var(--text);
    font-family:'Inter',sans-serif;
    -webkit-tap-highlight-color:transparent;
    overscroll-behavior:none;
    min-height:100vh;
    padding-bottom:76px;
  }
  h1,h2,h3,.brand,.stat-num,.tab-label{font-family:'Barlow Condensed',sans-serif;}
  ::-webkit-scrollbar{display:none;}

  /* ---------- Header ---------- */
  header{
    position:sticky; top:0; z-index:40;
    background:linear-gradient(180deg,#181b21 0%, #15171c 100%);
    border-bottom:1px solid var(--line);
    padding:14px 16px 12px;
  }
  .brand-row{display:flex; align-items:center; gap:10px;}
  .gear{width:30px;height:30px;flex-shrink:0;}
  .brand{font-weight:800; font-size:26px; letter-spacing:.3px; line-height:1; color:var(--text);}
  .brand em{font-style:normal; color:var(--amber);}
  .sub{color:var(--text-dim); font-size:12.5px; margin-top:2px; letter-spacing:.2px;}
  .sync-dot{width:7px;height:7px;border-radius:50%; background:var(--green); display:inline-block; margin-right:5px; box-shadow:0 0 0 3px rgba(95,168,118,.15);}
  .sync-dot.off{background:var(--text-dim); box-shadow:none;}

  /* ---------- Layout ---------- */
  main{max-width:640px; margin:0 auto; padding:16px;}
  .hide{display:none !important;}
  .brand-row{position:relative;}

  /* ---------- Dashboard ---------- */
  .stat-grid{display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:18px;}
  .stat-card{
    background:var(--bg-elev); border:1px solid var(--line); border-radius:var(--radius);
    padding:14px 14px 12px; position:relative; overflow:hidden;
  }
  .stat-card::before{content:''; position:absolute; left:0; top:0; bottom:0; width:3px;}
  .stat-card.c-amber::before{background:var(--amber);}
  .stat-card.c-blue::before{background:var(--blue);}
  .stat-card.c-green::before{background:var(--green);}
  .stat-card.c-red::before{background:var(--red);}
  .stat-label{color:var(--text-dim); font-size:12px; font-weight:500; margin-bottom:6px;}
  .stat-num{font-size:28px; font-weight:700; line-height:1;}
  .stat-num small{font-size:15px; font-weight:600; color:var(--text-dim);}

  .section-title{font-size:20px; font-weight:700; margin:22px 0 10px; display:flex; align-items:center; justify-content:space-between;}
  .section-title span.count{font-family:'Inter',sans-serif; font-size:12px; font-weight:600; color:var(--text-dim); background:var(--bg-elev2); padding:2px 8px; border-radius:20px;}

  /* ---------- Cards (OS list) ---------- */
  .os-card{
    background:var(--bg-elev); border:1px solid var(--line); border-radius:var(--radius);
    padding:13px 14px; margin-bottom:10px; cursor:pointer;
  }
  .os-card:active{background:var(--bg-elev2);}
  .os-top{display:flex; justify-content:space-between; align-items:flex-start; gap:10px;}
  .os-cliente{font-weight:700; font-size:16px;}
  .os-veic{color:var(--text-dim); font-size:13px; margin-top:1px;}
  .os-desc{color:var(--text); font-size:13.5px; margin-top:8px; line-height:1.4;}
  .os-bottom{display:flex; justify-content:space-between; align-items:center; margin-top:10px;}
  .os-valor{font-weight:700; font-size:15px;}
  .badge{font-size:11px; font-weight:700; padding:3px 9px; border-radius:20px; letter-spacing:.2px;}
  .badge.aberta{background:#3a2f1c; color:var(--amber);}
  .badge.andamento{background:#1c2c3a; color:var(--blue);}
  .badge.concluida{background:#1c3324; color:var(--green);}
  .badge.entregue{background:#2a2d34; color:var(--text-dim);}
  .pago-tag{font-size:11px; color:var(--green); font-weight:600;}
  .pendente-tag{font-size:11px; color:var(--red); font-weight:600;}

  .empty{
    text-align:center; padding:40px 20px; color:var(--text-dim);
    border:1px dashed var(--line); border-radius:var(--radius);
  }
  .empty svg{opacity:.4; margin-bottom:10px;}
  .empty p{margin:0; font-size:14px;}

  /* ---------- Clientes ---------- */
  .cli-card{
    background:var(--bg-elev); border:1px solid var(--line); border-radius:var(--radius);
    padding:13px 14px; margin-bottom:10px; display:flex; justify-content:space-between; align-items:center; gap:10px; cursor:pointer;
  }
  .cli-card:active{background:var(--bg-elev2);}
  .cli-nome{font-weight:700; font-size:15.5px;}
  .cli-info{color:var(--text-dim); font-size:13px; margin-top:2px;}
  .cli-arrow{color:var(--text-dim); flex-shrink:0;}

  /* ---------- Financeiro ---------- */
  .fin-toggle{display:flex; gap:8px; margin-bottom:14px;}
  .fin-toggle button{
    flex:1; padding:9px; border-radius:8px; border:1px solid var(--line); background:var(--bg-elev);
    color:var(--text-dim); font-weight:600; font-size:13.5px; font-family:'Inter',sans-serif;
  }
  .fin-toggle button.active{background:var(--amber-dim); color:var(--amber); border-color:var(--amber);}
  .fin-row{
    display:flex; justify-content:space-between; align-items:center; padding:12px 14px;
    background:var(--bg-elev); border:1px solid var(--line); border-radius:var(--radius); margin-bottom:8px;
  }
  .fin-desc{font-size:14px; font-weight:600;}
  .fin-date{font-size:12px; color:var(--text-dim); margin-top:2px;}
  .fin-val{font-weight:700; font-size:15px;}
  .fin-val.rec{color:var(--green);}
  .fin-val.desp{color:var(--red);}

  /* ---------- Bottom nav ---------- */
  nav.tabs{
    position:fixed; bottom:0; left:0; right:0; z-index:50;
    background:#181b21; border-top:1px solid var(--line);
    display:flex; padding:6px 4px calc(6px + env(safe-area-inset-bottom));
  }
  .tab-btn{
    flex:1; background:none; border:none; color:var(--text-dim);
    display:flex; flex-direction:column; align-items:center; gap:3px; padding:6px 0; font-family:'Inter',sans-serif;
  }
  .tab-btn.active{color:var(--amber);}
  .tab-btn svg{width:22px;height:22px;}
  .tab-label{font-size:11px; font-weight:600; letter-spacing:.2px;}

  /* ---------- FAB ---------- */
  .fab{
    position:fixed; right:18px; bottom:84px; z-index:45;
    width:54px; height:54px; border-radius:50%; background:var(--amber); color:#20180a;
    border:none; display:flex; align-items:center; justify-content:center;
    box-shadow:0 6px 16px rgba(242,169,59,.35); font-size:28px; font-weight:700;
  }
  .fab:active{transform:scale(.94);}

  /* ---------- Modal / sheet ---------- */
  .overlay{
    position:fixed; inset:0; background:rgba(0,0,0,.55); z-index:100;
    display:flex; align-items:flex-end; justify-content:center;
  }
  .sheet{
    background:var(--bg-elev); width:100%; max-width:640px; max-height:92vh; overflow-y:auto;
    border-radius:16px 16px 0 0; padding:18px 18px calc(20px + env(safe-area-inset-bottom));
    animation:slideup .18s ease-out;
  }
  @keyframes slideup{from{transform:translateY(24px); opacity:0;} to{transform:translateY(0); opacity:1;}}
  .sheet-handle{width:36px; height:4px; background:var(--line); border-radius:4px; margin:0 auto 14px;}
  .sheet-title{font-size:21px; font-weight:700; margin-bottom:16px; display:flex; justify-content:space-between; align-items:center;}
  .sheet-close{background:none; border:none; color:var(--text-dim); font-size:22px; padding:0 4px;}

  label{display:block; font-size:12.5px; font-weight:600; color:var(--text-dim); margin:14px 0 6px;}
  label:first-of-type{margin-top:0;}
  input,select,textarea{
    width:100%; background:var(--bg); border:1px solid var(--line); border-radius:8px;
    padding:11px 12px; color:var(--text); font-family:'Inter',sans-serif; font-size:15px;
  }
  input:focus,select:focus,textarea:focus{outline:none; border-color:var(--amber);}
  textarea{resize:vertical; min-height:64px;}
  .row2{display:grid; grid-template-columns:1fr 1fr; gap:10px;}

  .item-line{display:flex; gap:8px; align-items:center; margin-bottom:8px;}
  .item-line input:first-child{flex:1;}
  .item-line input.val{width:100px;}
  .item-del{background:none; border:none; color:var(--red); font-size:20px; padding:0 4px;}
  .add-item-btn{
    width:100%; padding:9px; border:1px dashed var(--line); border-radius:8px; background:none;
    color:var(--text-dim); font-size:13.5px; font-weight:600; margin-top:4px; font-family:'Inter',sans-serif;
  }
  .total-line{display:flex; justify-content:space-between; align-items:center; padding:12px 0 4px; font-weight:700; font-size:16px; border-top:1px solid var(--line); margin-top:12px;}

  .btn-primary{
    width:100%; padding:13px; border-radius:9px; border:none; background:var(--amber); color:#20180a;
    font-weight:700; font-size:15.5px; margin-top:18px; font-family:'Inter',sans-serif;
  }
  .btn-primary:active{opacity:.85;}
  .btn-secondary{
    width:100%; padding:13px; border-radius:9px; border:1px solid var(--line); background:none; color:var(--text);
    font-weight:600; font-size:14.5px; margin-top:10px; font-family:'Inter',sans-serif;
  }
  .btn-danger{color:var(--red);}

  .status-picker{display:flex; gap:6px; flex-wrap:wrap;}
  .status-opt{
    flex:1; min-width:80px; text-align:center; padding:9px 6px; border-radius:8px; border:1px solid var(--line);
    color:var(--text-dim); font-size:12.5px; font-weight:600; font-family:'Inter',sans-serif;
  }
  .status-opt.sel{border-color:var(--amber); color:var(--amber); background:var(--amber-dim);}

  .pay-toggle{display:flex; gap:8px;}
  .pay-opt{flex:1; text-align:center; padding:10px; border-radius:8px; border:1px solid var(--line); color:var(--text-dim); font-size:13.5px; font-weight:600; font-family:'Inter',sans-serif;}
  .pay-opt.sel-yes{border-color:var(--green); color:var(--green); background:#132018;}
  .pay-opt.sel-no{border-color:var(--red); color:var(--red); background:#241414;}

  .credit{
    text-align:center; color:var(--text-dim); font-size:11px; margin-top:26px; padding-bottom:6px; letter-spacing:.2px;
  }
  .setup-box{
    background:var(--bg-elev); border:1px solid var(--line); border-radius:var(--radius); padding:16px; margin-top:12px;
  }
  .toast{
    position:fixed; bottom:88px; left:50%; transform:translateX(-50%); background:#242833; color:var(--text);
    padding:10px 18px; border-radius:8px; font-size:13.5px; font-weight:600; z-index:200; border:1px solid var(--line);
    box-shadow:0 6px 18px rgba(0,0,0,.35);
  }

  /* ---------- Login (perfis estilo Netflix) ---------- */
  #view-login{
    position:fixed; inset:0; z-index:300; background:var(--bg);
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    padding:24px; text-align:center;
  }
  .login-brand{font-size:30px; font-weight:800; margin-bottom:4px;}
  .login-brand em{font-style:normal; color:var(--amber);}
  .login-sub{color:var(--text-dim); font-size:13.5px; margin-bottom:30px;}
  .profile-grid{display:flex; flex-wrap:wrap; gap:20px; justify-content:center; max-width:420px;}
  .profile-card{width:84px; display:flex; flex-direction:column; align-items:center; gap:8px; cursor:pointer;}
  .profile-avatar{
    width:72px; height:72px; border-radius:14px; background:var(--bg-elev2); border:2px solid var(--line);
    display:flex; align-items:center; justify-content:center; font-size:26px; font-weight:800; color:var(--text-dim);
    font-family:'Barlow Condensed',sans-serif; position:relative;
  }
  .profile-card:active .profile-avatar{border-color:var(--amber); color:var(--amber);}
  .profile-name{font-size:12.5px; font-weight:600; color:var(--text); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:80px;}
  .profile-admin-dot{
    position:absolute; top:-4px; right:-4px; width:16px; height:16px; border-radius:50%;
    background:var(--amber); color:#20180a; font-size:9px; font-weight:800; display:flex; align-items:center; justify-content:center;
  }
  .profile-add .profile-avatar{border-style:dashed; font-size:30px;}

  .pin-dots{display:flex; gap:14px; justify-content:center; margin:22px 0 26px;}
  .pin-dot{width:14px; height:14px; border-radius:50%; border:2px solid var(--line); background:none;}
  .pin-dot.filled{background:var(--amber); border-color:var(--amber);}
  .pin-keypad{display:grid; grid-template-columns:repeat(3,64px); gap:14px; justify-content:center;}
  .pin-key{
    width:64px; height:64px; border-radius:50%; background:var(--bg-elev2); border:1px solid var(--line);
    color:var(--text); font-size:22px; font-weight:700; font-family:'Inter',sans-serif;
  }
  .pin-key:active{background:var(--amber-dim); color:var(--amber);}
  .pin-key.empty{background:none; border:none;}
  .pin-name{font-size:17px; font-weight:700; margin-bottom:2px;}
  .pin-back{color:var(--text-dim); font-size:13px; font-weight:600; margin-top:22px; background:none; border:none; padding:6px;}

  /* ---------- Header / conta ---------- */
  .acc-btn{
    margin-left:auto; width:34px; height:34px; border-radius:9px; background:var(--bg-elev2); border:1px solid var(--line);
    color:var(--amber); font-weight:800; font-size:14px; display:flex; align-items:center; justify-content:center;
    font-family:'Barlow Condensed',sans-serif; flex-shrink:0;
  }

  /* ---------- Admin: gerenciar usuários ---------- */
  .user-row{
    display:flex; justify-content:space-between; align-items:center; padding:12px 14px;
    background:var(--bg-elev); border:1px solid var(--line); border-radius:var(--radius); margin-bottom:8px; cursor:pointer;
  }
  .user-row:active{background:var(--bg-elev2);}
  .user-nome{font-weight:700; font-size:15px; display:flex; align-items:center; gap:6px;}
  .user-tag{font-size:10.5px; font-weight:700; color:var(--amber); background:var(--amber-dim); padding:2px 7px; border-radius:20px;}
  .acc-menu-item{
    width:100%; text-align:left; padding:13px 4px; background:none; border:none; color:var(--text);
    font-size:15px; font-weight:600; font-family:'Inter',sans-serif; border-bottom:1px solid var(--line); display:flex; align-items:center; gap:10px;
  }
  .acc-menu-item:last-child{border-bottom:none;}
  .acc-menu-item.danger{color:var(--red);}
</style>
</head>
<body>

<header>
  <div class="brand-row">
    <svg class="gear" viewBox="0 0 24 24" fill="none">
      <path d="M12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7Z" stroke="#f2a93b" stroke-width="1.6"/>
      <path d="M19.4 13.5c.05-.33.08-.66.08-1s-.03-.67-.08-1l1.6-1.25a.5.5 0 0 0 .12-.64l-1.5-2.6a.5.5 0 0 0-.6-.22l-1.9.76a7.4 7.4 0 0 0-1.73-1l-.29-2.02a.5.5 0 0 0-.5-.43h-3a.5.5 0 0 0-.5.43l-.29 2.02a7.4 7.4 0 0 0-1.73 1l-1.9-.76a.5.5 0 0 0-.6.22l-1.5 2.6a.5.5 0 0 0 .12.64l1.6 1.25c-.05.33-.08.66-.08 1s.03.67.08 1l-1.6 1.25a.5.5 0 0 0-.12.64l1.5 2.6c.13.22.4.31.6.22l1.9-.76c.52.42 1.1.76 1.73 1l.29 2.02c.05.25.26.43.5.43h3c.24 0 .45-.18.5-.43l.29-2.02a7.4 7.4 0 0 0 1.73-1l1.9.76c.22.09.47 0 .6-.22l1.5-2.6a.5.5 0 0 0-.12-.64L19.4 13.5Z" stroke="#e9ebef" stroke-width="1.4" stroke-linejoin="round"/>
    </svg>
    <div>
      <div class="brand">Oficina do <em>Negão</em></div>
      <div class="sub"><span class="sync-dot off" id="syncDot"></span><span id="syncText">conectando…</span></div>
    </div>
    <button class="acc-btn hide" id="accBtn">?</button>
  </div>
</header>

<!-- LOGIN (perfis) -->
<div id="view-login" class="hide">
  <div class="login-brand">Oficina do <em>Negão</em></div>
  <div class="login-sub" id="loginSub">Quem está usando?</div>
  <div class="profile-grid" id="profileGrid"></div>
</div>

<main id="appMain" class="hide">

  <!-- DASHBOARD -->
  <section id="view-dashboard">
    <div class="stat-grid">
      <div class="stat-card c-amber">
        <div class="stat-label">OS em aberto</div>
        <div class="stat-num" id="statAbertas">0</div>
      </div>
      <div class="stat-card c-blue">
        <div class="stat-label">Em andamento</div>
        <div class="stat-num" id="statAndamento">0</div>
      </div>
      <div class="stat-card c-green">
        <div class="stat-label">Faturado no mês</div>
        <div class="stat-num" id="statFaturado"><small>R$</small>0</div>
      </div>
      <div class="stat-card c-red">
        <div class="stat-label">A receber</div>
        <div class="stat-num" id="statReceber"><small>R$</small>0</div>
      </div>
    </div>

    <div class="section-title">Últimas OS <span class="count" id="countRecentes">0</span></div>
    <div id="listRecentes"></div>
    <div class="credit">Desenvolvido por João Divino Barbosa</div>
  </section>

  <!-- ORDENS DE SERVIÇO -->
  <section id="view-os" class="hide">
    <div class="section-title">Ordens de Serviço <span class="count" id="countOS">0</span></div>
    <div id="listOS"></div>
  </section>

  <!-- CLIENTES -->
  <section id="view-clientes" class="hide">
    <div class="section-title">Clientes &amp; Veículos <span class="count" id="countClientes">0</span></div>
    <div id="listClientes"></div>
  </section>

  <!-- FINANCEIRO -->
  <section id="view-financeiro" class="hide">
    <div class="section-title">Financeiro</div>
    <div class="stat-grid">
      <div class="stat-card c-green">
        <div class="stat-label">Receitas do mês</div>
        <div class="stat-num" id="finReceitas"><small>R$</small>0</div>
      </div>
      <div class="stat-card c-red">
        <div class="stat-label">Despesas do mês</div>
        <div class="stat-num" id="finDespesas"><small>R$</small>0</div>
      </div>
    </div>
    <div class="stat-card c-blue" style="margin-bottom:18px;">
      <div class="stat-label">Saldo do mês</div>
      <div class="stat-num" id="finSaldo"><small>R$</small>0</div>
    </div>
    <div class="fin-toggle">
      <button id="filtTodos" class="active">Todos</button>
      <button id="filtRec">Receitas</button>
      <button id="filtDesp">Despesas</button>
    </div>
    <div id="listFinanceiro"></div>
  </section>

  <!-- SETUP FIREBASE (mostrado só se não configurado) -->
  <section id="view-setup" class="hide">
    <div class="section-title">Conectar ao Firebase</div>
    <div class="setup-box">
      <p style="color:var(--text-dim); font-size:13.5px; line-height:1.5; margin-top:0;">
        Para sincronizar entre aparelhos, cole abaixo a configuração do seu projeto Firebase (Console → Configurações do projeto → Seus apps → SDK config). Fica salvo neste aparelho.
      </p>
      <label>Config do Firebase (objeto firebaseConfig)</label>
      <textarea id="fbConfigInput" style="min-height:140px; font-family:monospace; font-size:12.5px;" placeholder='{
  "apiKey": "...",
  "authDomain": "...",
  "projectId": "...",
  "storageBucket": "...",
  "messagingSenderId": "...",
  "appId": "..."
}'></textarea>
      <label>Código da oficina (workspace)</label>
      <input id="fbWorkspaceInput" placeholder="ex: oficina-negao" value="oficina-negao">
      <div style="color:var(--text-dim); font-size:12px; margin-top:6px;">Use o mesmo código em todos os aparelhos da equipe para compartilhar os dados.</div>
      <button class="btn-primary" id="btnSalvarConfig">Salvar e conectar</button>
    </div>
  </section>

</main>

<button class="fab hide" id="fabAdd">+</button>

<nav class="tabs hide" id="appNav">
  <button class="tab-btn active" data-view="dashboard">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 12 12 4l9 8" stroke-linecap="round" stroke-linejoin="round"/><path d="M5 10.5V20h14v-9.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    <span class="tab-label">Início</span>
  </button>
  <button class="tab-btn" data-view="os">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M7 3h7l4 4v14H7z" stroke-linejoin="round"/><path d="M14 3v4h4M9 12h6M9 15.5h6M9 8.5h2" stroke-linecap="round"/></svg>
    <span class="tab-label">OS</span>
  </button>
  <button class="tab-btn" data-view="clientes">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="9" cy="8" r="3.2"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6" stroke-linecap="round"/><path d="M16 8.2a3.2 3.2 0 1 1 2.2 5.5M18 14c2.2.4 3.8 2.3 3.9 4.6" stroke-linecap="round"/></svg>
    <span class="tab-label">Clientes</span>
  </button>
  <button class="tab-btn" data-view="financeiro">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3v18M8 7.5c0-1.5 1.7-2.5 4-2.5s4 1 4 2.5-1.7 2.2-4 2.5c-2.3.3-4 1-4 2.5s1.7 2.5 4 2.5 4-1 4-2.5" stroke-linecap="round"/></svg>
    <span class="tab-label">Financeiro</span>
  </button>
</nav>

<div id="modalRoot"></div>
<div id="toastRoot"></div>

<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-auth-compat.js"></script>

<script>
/* ==================== ESTADO ==================== */
window.addEventListener('error', function(e){
  alert('ERRO JS:\n' + e.message + '\nArquivo: ' + (e.filename||'').split('/').pop() + '\nLinha: ' + e.lineno);
});
window.addEventListener('unhandledrejection', function(e){
  alert('ERRO (promise):\n' + (e.reason && e.reason.message ? e.reason.message : e.reason));
});
let db = null;
let WORKSPACE = localStorage.getItem('oficina_workspace') || 'oficina-negao';
let clientes = [];
let ordens = [];
let financeiroExtra = []; // lançamentos manuais (despesas/receitas avulsas)
let usuarios = [];
let currentUser = null;
let currentView = 'dashboard';
let finFilter = 'todos';
let unsubs = [];

function getDeviceId(){
  let id = localStorage.getItem('oficina_deviceId');
  if(!id){ id = uid()+uid(); localStorage.setItem('oficina_deviceId', id); }
  return id;
}

/* ==================== UTIL ==================== */
function fmtMoney(v){
  return (v||0).toLocaleString('pt-BR',{minimumFractionDigits:2, maximumFractionDigits:2});
}
function todayISO(){ return new Date().toISOString().slice(0,10); }
function fmtDate(iso){
  if(!iso) return '';
  const [y,m,d] = iso.split('-');
  return `${d}/${m}/${y}`;
}
function uid(){ return Date.now().toString(36) + Math.random().toString(36).slice(2,7); }
function isThisMonth(iso){
  if(!iso) return false;
  const now = new Date(); const d = new Date(iso+'T00:00:00');
  return d.getFullYear()===now.getFullYear() && d.getMonth()===now.getMonth();
}
function toast(msg){
  const el = document.createElement('div');
  el.className='toast'; el.textContent=msg;
  document.getElementById('toastRoot').appendChild(el);
  setTimeout(()=>el.remove(), 2200);
}
function statusLabel(s){
  return {aberta:'Aberta', andamento:'Em andamento', concluida:'Concluída', entregue:'Entregue'}[s]||s;
}
function osTotal(os){
  return (os.itens||[]).reduce((s,i)=> s + (parseFloat(i.valor)||0), 0);
}

/* ==================== FIREBASE ==================== */
// Config fixa do projeto Firebase (compartilhado com o app Manutenção Simples).
// Cada app usa seu próprio WORKSPACE dentro da coleção 'oficinas', então os dados não se misturam.
const FIREBASE_CONFIG_PADRAO = {
  apiKey: "AIzaSyA0pXtPWBM0NmLLs46IbuFSQK7NbfCzfmU",
  authDomain: "banco-de-dados-c70e2.firebaseapp.com",
  projectId: "banco-de-dados-c70e2",
  storageBucket: "banco-de-dados-c70e2.firebasestorage.app",
  messagingSenderId: "1089455356929",
  appId: "1:1089455356929:web:ba9d26f956928ba0941400"
};

function tryConnect(){
  let cfgRaw = localStorage.getItem('oficina_fbconfig');
  if(!cfgRaw){
    // Primeira vez neste aparelho: usa a config fixa automaticamente, sem precisar colar nada.
    localStorage.setItem('oficina_fbconfig', JSON.stringify(FIREBASE_CONFIG_PADRAO));
    cfgRaw = localStorage.getItem('oficina_fbconfig');
  }
  try{
    const cfg = JSON.parse(cfgRaw);
    if(!firebase.apps.length){ firebase.initializeApp(cfg); }
    db = firebase.firestore();
    firebase.auth().signInAnonymously().then(()=>{
      startListeners();
    }).catch(err=>{
      console.error(err);
      alert('Falha na autenticação Firebase:\n' + err.code + '\n' + err.message);
      setSync(false, 'erro de autenticação');
    });
  }catch(e){
    console.error(e);
    alert('Falha ao iniciar Firebase:\n' + e.message);
    showSetup();
  }
}

function setSync(ok, label){
  document.getElementById('syncDot').className = 'sync-dot' + (ok?'':' off');
  document.getElementById('syncText').textContent = label;
}

function startListeners(){
  setSync(true, 'sincronizado · ' + WORKSPACE);
  document.getElementById('view-setup').classList.add('hide');

  const base = db.collection('oficinas').doc(WORKSPACE);

  unsubs.forEach(u=>u());
  unsubs = [];

  unsubs.push(base.collection('clientes').orderBy('nome').onSnapshot(snap=>{
    clientes = snap.docs.map(d=>({id:d.id, ...d.data()}));
    renderAll();
  }, err=>{ console.error(err); setSync(false,'erro de conexão'); }));

  unsubs.push(base.collection('ordens').orderBy('dataAbertura','desc').onSnapshot(snap=>{
    ordens = snap.docs.map(d=>({id:d.id, ...d.data()}));
    renderAll();
  }, err=>{ console.error(err); setSync(false,'erro de conexão'); }));

  unsubs.push(base.collection('financeiro').orderBy('data','desc').onSnapshot(snap=>{
    financeiroExtra = snap.docs.map(d=>({id:d.id, ...d.data()}));
    renderAll();
  }, err=>{ console.error(err); setSync(false,'erro de conexão'); }));

  unsubs.push(base.collection('usuarios').orderBy('nome').onSnapshot(snap=>{
    usuarios = snap.docs.map(d=>({id:d.id, ...d.data()}));
    handleUsuariosLoaded();
  }, err=>{ console.error(err); setSync(false,'erro de conexão'); }));
}

function baseCol(name){ return db.collection('oficinas').doc(WORKSPACE).collection(name); }

function showSetup(){
  setSync(false, 'não conectado');
  document.getElementById('view-login').classList.add('hide');
  document.getElementById('appNav').classList.add('hide');
  document.getElementById('fabAdd').classList.add('hide');
  document.getElementById('accBtn').classList.add('hide');
  document.getElementById('appMain').classList.remove('hide');
  ['dashboard','os','clientes','financeiro'].forEach(v=>document.getElementById('view-'+v).classList.add('hide'));
  document.getElementById('view-setup').classList.remove('hide');
  document.getElementById('fbWorkspaceInput').value = WORKSPACE;
}

/* ==================== LOGIN / USUÁRIOS (estilo perfis) ==================== */
function handleUsuariosLoaded(){
  if(currentUser){
    const upd = usuarios.find(u=>u.id===currentUser.id);
    if(upd){ currentUser = upd; renderAccBtn(); }
    else { logout(); }
    return;
  }
  if(usuarios.length===0){
    showFirstAdminSetup();
    return;
  }
  const savedId = localStorage.getItem('oficina_currentUser');
  if(savedId){
    const u = usuarios.find(x=>x.id===savedId);
    if(u && (u.admin || !u.deviceId || u.deviceId===getDeviceId())){
      loginAs(u);
      return;
    }
  }
  showProfiles();
}

function showFirstAdminSetup(){
  document.getElementById('appMain').classList.add('hide');
  document.getElementById('appNav').classList.add('hide');
  document.getElementById('fabAdd').classList.add('hide');
  document.getElementById('accBtn').classList.add('hide');
  document.getElementById('view-login').classList.remove('hide');
  document.getElementById('loginSub').textContent = 'Crie o usuário administrador para começar';
  const grid = document.getElementById('profileGrid');
  grid.innerHTML = '';
  const card = document.createElement('div');
  card.className = 'profile-card profile-add';
  card.innerHTML = `<div class="profile-avatar">+</div><div class="profile-name">Criar admin</div>`;
  card.addEventListener('click', ()=>{
    alert('Toque detectado, abrindo formulário...');
    try{
      openUserEditModal(null, true);
    }catch(e){
      alert('Erro ao abrir formulário:\n' + e.message);
    }
  });
  grid.appendChild(card);
}

function showProfiles(){
  document.getElementById('appMain').classList.add('hide');
  document.getElementById('appNav').classList.add('hide');
  document.getElementById('fabAdd').classList.add('hide');
  document.getElementById('accBtn').classList.add('hide');
  document.getElementById('view-login').classList.remove('hide');
  document.getElementById('loginSub').textContent = 'Quem está usando?';
  const grid = document.getElementById('profileGrid');
  grid.innerHTML = '';
  usuarios.forEach(u=>{
    const card = document.createElement('div');
    card.className = 'profile-card';
    card.innerHTML = `
      <div class="profile-avatar">${escapeHtml((u.nome||'?').trim().charAt(0).toUpperCase())}${u.admin?'<span class="profile-admin-dot">★</span>':''}</div>
      <div class="profile-name">${escapeHtml(u.nome||'')}</div>
    `;
    card.addEventListener('click', ()=> openPinModal(u));
    grid.appendChild(card);
  });
}

function openPinModal(usuario){
  let digits = '';
  const html = `
    <div class="overlay" id="ovPin">
      <div class="sheet" style="text-align:center;">
        <div class="sheet-handle"></div>
        <div class="pin-name">${escapeHtml(usuario.nome||'')}</div>
        <div style="color:var(--text-dim); font-size:12.5px; margin-bottom:4px;">Digite o PIN</div>
        <div class="pin-dots" id="pinDots">
          ${[0,1,2,3].map(i=>`<span class="pin-dot" data-i="${i}"></span>`).join('')}
        </div>
        <div class="pin-keypad" id="pinKeypad">
          ${[1,2,3,4,5,6,7,8,9].map(n=>`<button type="button" class="pin-key" data-n="${n}">${n}</button>`).join('')}
          <span></span>
          <button type="button" class="pin-key" data-n="0">0</button>
          <button type="button" class="pin-key" id="pinDel">⌫</button>
        </div>
        <button class="pin-back" id="pinBack">← Trocar de perfil</button>
      </div>
    </div>
  `;
  document.getElementById('modalRoot').innerHTML = html;
  document.getElementById('ovPin').addEventListener('click', e=>{ if(e.target.id==='ovPin') closeModal(); });
  document.getElementById('pinBack').addEventListener('click', closeModal);

  function updateDots(){
    document.querySelectorAll('#pinDots .pin-dot').forEach((d,i)=> d.classList.toggle('filled', i<digits.length));
  }
  function tryVerify(){
    if(String(usuario.pin||'')===digits){
      closeModal();
      loginAs(usuario);
    } else {
      toast('PIN incorreto');
      digits='';
      updateDots();
    }
  }
  document.querySelectorAll('#pinKeypad .pin-key[data-n]').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      if(digits.length>=4) return;
      digits += btn.dataset.n;
      updateDots();
      if(digits.length===4) setTimeout(tryVerify, 120);
    });
  });
  document.getElementById('pinDel').addEventListener('click', ()=>{
    digits = digits.slice(0,-1);
    updateDots();
  });
}

function loginAs(usuario){
  const dId = getDeviceId();
  if(!usuario.admin){
    if(!usuario.deviceId){
      baseCol('usuarios').doc(usuario.id).update({deviceId: dId}).catch(()=>{});
      usuario = {...usuario, deviceId: dId};
    } else if(usuario.deviceId !== dId){
      toast('Este perfil já está vinculado a outro aparelho');
      return;
    }
  }
  currentUser = usuario;
  localStorage.setItem('oficina_currentUser', usuario.id);
  document.getElementById('view-login').classList.add('hide');
  document.getElementById('appMain').classList.remove('hide');
  document.getElementById('appNav').classList.remove('hide');
  document.getElementById('fabAdd').classList.remove('hide');
  document.getElementById('accBtn').classList.remove('hide');
  renderAccBtn();
  renderView();
  renderAll();
}

function logout(){
  currentUser = null;
  localStorage.removeItem('oficina_currentUser');
  closeModal();
  showProfiles();
}

function renderAccBtn(){
  if(!currentUser) return;
  document.getElementById('accBtn').textContent = (currentUser.nome||'?').trim().charAt(0).toUpperCase();
}

function escapeHtml(s){
  return String(s==null?'':s).replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

document.getElementById('accBtn').addEventListener('click', openAccountMenu);
function openAccountMenu(){
  const html = `
    <div class="overlay" id="ovAcc">
      <div class="sheet">
        <div class="sheet-handle"></div>
        <div class="sheet-title">${escapeHtml(currentUser?currentUser.nome:'')}<button class="sheet-close" id="closeAcc">✕</button></div>
        ${currentUser && currentUser.admin? `<button class="acc-menu-item" id="btnGerenciarUsuarios">👥 Gerenciar usuários</button>`:''}
        <button class="acc-menu-item danger" id="btnTrocarPerfil">↩ Trocar de perfil</button>
      </div>
    </div>
  `;
  document.getElementById('modalRoot').innerHTML = html;
  document.getElementById('closeAcc').addEventListener('click', closeModal);
  document.getElementById('ovAcc').addEventListener('click', e=>{ if(e.target.id==='ovAcc') closeModal(); });
  const gBtn = document.getElementById('btnGerenciarUsuarios');
  if(gBtn) gBtn.addEventListener('click', ()=>{ closeModal(); openAdminUsersModal(); });
  document.getElementById('btnTrocarPerfil').addEventListener('click', ()=>{ closeModal(); logout(); });
}

/* ==================== PAINEL ADM: usuários ==================== */
function openAdminUsersModal(){
  const html = `
    <div class="overlay" id="ovUsers">
      <div class="sheet">
        <div class="sheet-handle"></div>
        <div class="sheet-title">Usuários<button class="sheet-close" id="closeUsers">✕</button></div>
        <div id="usersList"></div>
        <button class="btn-primary" id="btnNovoUsuario">+ Novo usuário</button>
      </div>
    </div>
  `;
  document.getElementById('modalRoot').innerHTML = html;
  document.getElementById('closeUsers').addEventListener('click', closeModal);
  document.getElementById('ovUsers').addEventListener('click', e=>{ if(e.target.id==='ovUsers') closeModal(); });
  const wrap = document.getElementById('usersList');
  usuarios.forEach(u=>{
    const row = document.createElement('div');
    row.className='user-row';
    row.innerHTML = `
      <div class="user-nome">${escapeHtml(u.nome)}${u.admin?'<span class="user-tag">ADM</span>':''}</div>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--text-dim);"><path d="M9 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
    `;
    row.addEventListener('click', ()=> openUserEditModal(u));
    wrap.appendChild(row);
  });
  document.getElementById('btnNovoUsuario').addEventListener('click', ()=> openUserEditModal(null));
}

function openUserEditModal(u, forceAdmin){
  const isNew = !u;
  let admin = forceAdmin ? true : (u? !!u.admin : false);
  const html = `
    <div class="overlay" id="ovUserEdit">
      <div class="sheet">
        <div class="sheet-handle"></div>
        <div class="sheet-title">${isNew?(forceAdmin?'Novo administrador':'Novo usuário'):'Editar usuário'}<button class="sheet-close" id="closeUserEdit">✕</button></div>

        <label>Nome</label>
        <input id="uNome" placeholder="Nome do usuário" value="${u?escapeHtml(u.nome||''):''}">

        <label>PIN (4 dígitos)</label>
        <input id="uPin" inputmode="numeric" maxlength="4" placeholder="${isNew?'0000':'Deixe em branco para manter o atual'}" value="">

        ${forceAdmin? '' : `
        <label>Administrador</label>
        <div class="pay-toggle">
          <div class="pay-opt ${admin?'sel-yes':''}" id="uAdmSim">Sim</div>
          <div class="pay-opt ${!admin?'sel-no':''}" id="uAdmNao">Não</div>
        </div>`}

        <button class="btn-primary" id="uSalvar">${isNew?'Criar usuário':'Salvar alterações'}</button>
        ${!isNew && !forceAdmin? '<button class="btn-secondary btn-danger" id="uExcluir">Excluir usuário</button>':''}
      </div>
    </div>
  `;
  document.getElementById('modalRoot').innerHTML = html;
  document.getElementById('closeUserEdit').addEventListener('click', closeModal);
  document.getElementById('ovUserEdit').addEventListener('click', e=>{ if(e.target.id==='ovUserEdit') closeModal(); });

  if(!forceAdmin){
    document.getElementById('uAdmSim').addEventListener('click', ()=>{
      admin=true;
      document.getElementById('uAdmSim').classList.add('sel-yes');
      document.getElementById('uAdmNao').classList.remove('sel-no');
    });
    document.getElementById('uAdmNao').addEventListener('click', ()=>{
      admin=false;
      document.getElementById('uAdmNao').classList.add('sel-no');
      document.getElementById('uAdmSim').classList.remove('sel-yes');
    });
  }

  document.getElementById('uSalvar').addEventListener('click', ()=>{
    const nome = document.getElementById('uNome').value.trim();
    const pinRaw = document.getElementById('uPin').value.trim();
    if(!nome){ toast('Informe o nome'); return; }
    if((isNew || pinRaw) && !/^\d{4}$/.test(pinRaw)){ toast('PIN deve ter 4 números'); return; }

    if(isNew){
      const data = { nome, pin: pinRaw, admin, deviceId: (forceAdmin? getDeviceId() : null) };
      baseCol('usuarios').add(data).then(()=>{ toast('Usuário criado'); closeModal(); }).catch(err=>{ alert('Erro ao salvar usuário:\n' + err.code + '\n' + err.message); });
    } else {
      const data = { nome, admin };
      if(pinRaw) data.pin = pinRaw;
      baseCol('usuarios').doc(u.id).update(data).then(()=>{ toast('Usuário atualizado'); closeModal(); }).catch(()=>toast('Erro ao salvar'));
    }
  });

  if(!isNew && !forceAdmin){
    document.getElementById('uExcluir').addEventListener('click', ()=>{
      if(currentUser && currentUser.id===u.id){ toast('Você não pode excluir seu próprio usuário'); return; }
      if(u.admin && usuarios.filter(x=>x.admin).length<=1){ toast('É preciso haver ao menos um administrador'); return; }
      if(confirm('Excluir este usuário?')){
        baseCol('usuarios').doc(u.id).delete().then(()=>{ toast('Usuário excluído'); closeModal(); });
      }
    });
  }
}

document.getElementById('btnSalvarConfig').addEventListener('click', ()=>{
  const raw = document.getElementById('fbConfigInput').value.trim();
  const ws = document.getElementById('fbWorkspaceInput').value.trim() || 'oficina-negao';
  try{
    const cfg = JSON.parse(raw);
    localStorage.setItem('oficina_fbconfig', JSON.stringify(cfg));
    localStorage.setItem('oficina_workspace', ws);
    WORKSPACE = ws;
    location.reload();
  }catch(e){
    toast('Config inválida — cole o objeto JSON completo');
  }
});

/* ==================== NAVEGAÇÃO ==================== */
document.querySelectorAll('.tab-btn').forEach(btn=>{
  btn.addEventListener('click', ()=>{
    document.querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('active'));
    btn.classList.add('active');
    currentView = btn.dataset.view;
    renderView();
  });
});
function renderView(){
  if(!db) return;
  ['dashboard','os','clientes','financeiro'].forEach(v=>{
    document.getElementById('view-'+v).classList.toggle('hide', v!==currentView);
  });
}

/* ==================== RENDER ==================== */
function renderAll(){
  renderDashboard();
  renderOS();
  renderClientes();
  renderFinanceiro();
}

function clienteNome(id){
  const c = clientes.find(c=>c.id===id);
  return c ? c.nome : 'Cliente removido';
}
function clienteVeic(id){
  const c = clientes.find(c=>c.id===id);
  return c ? c.veiculo : '';
}

function renderDashboard(){
  const abertas = ordens.filter(o=>o.status==='aberta').length;
  const andamento = ordens.filter(o=>o.status==='andamento').length;
  const faturadoMes = ordens.filter(o=> o.pago && isThisMonth(o.dataConclusao||o.dataAbertura)).reduce((s,o)=>s+osTotal(o),0);
  const aReceber = ordens.filter(o=> !o.pago && (o.status==='concluida'||o.status==='entregue')).reduce((s,o)=>s+osTotal(o),0);

  document.getElementById('statAbertas').textContent = abertas;
  document.getElementById('statAndamento').textContent = andamento;
  document.getElementById('statFaturado').innerHTML = '<small>R$</small>' + fmtMoney(faturadoMes);
  document.getElementById('statReceber').innerHTML = '<small>R$</small>' + fmtMoney(aReceber);

  const recentes = [...ordens].slice(0,5);
  document.getElementById('countRecentes').textContent = ordens.length;
  const wrap = document.getElementById('listRecentes');
  wrap.innerHTML = '';
  if(recentes.length===0){
    wrap.innerHTML = emptyState('Nenhuma OS ainda', 'Toque no + para abrir a primeira ordem de serviço.');
  } else {
    recentes.forEach(o=> wrap.appendChild(osCardEl(o)));
  }
}

function emptyState(title, sub){
  return `<div class="empty">
    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#9298a6" stroke-width="1.5"><path d="M7 3h7l4 4v14H7z" stroke-linejoin="round"/><path d="M14 3v4h4M9 12h6M9 15.5h6" stroke-linecap="round"/></svg>
    <p style="font-weight:600; color:var(--text); margin-bottom:4px;">${title}</p>
    <p>${sub}</p>
  </div>`;
}

function osCardEl(o){
  const div = document.createElement('div');
  div.className = 'os-card';
  const total = osTotal(o);
  div.innerHTML = `
    <div class="os-top">
      <div>
        <div class="os-cliente">${clienteNome(o.clienteId)}</div>
        <div class="os-veic">${clienteVeic(o.clienteId)||''}</div>
      </div>
      <span class="badge ${o.status}">${statusLabel(o.status)}</span>
    </div>
    <div class="os-desc">${(o.descricao||'').slice(0,90)}${(o.descricao||'').length>90?'…':''}</div>
    <div class="os-bottom">
      <span class="os-valor">R$ ${fmtMoney(total)}</span>
      <span class="${o.pago?'pago-tag':'pendente-tag'}">${o.pago?'Pago':'Pendente'}</span>
    </div>
  `;
  div.addEventListener('click', ()=> openOSModal(o));
  return div;
}

function renderOS(){
  document.getElementById('countOS').textContent = ordens.length;
  const wrap = document.getElementById('listOS');
  wrap.innerHTML = '';
  if(ordens.length===0){
    wrap.innerHTML = emptyState('Nenhuma OS ainda', 'Toque no + para abrir a primeira ordem de serviço.');
    return;
  }
  ordens.forEach(o=> wrap.appendChild(osCardEl(o)));
}

function renderClientes(){
  document.getElementById('countClientes').textContent = clientes.length;
  const wrap = document.getElementById('listClientes');
  wrap.innerHTML = '';
  if(clientes.length===0){
    wrap.innerHTML = emptyState('Nenhum cliente cadastrado', 'Toque no + para cadastrar o primeiro cliente.');
    return;
  }
  clientes.forEach(c=>{
    const div = document.createElement('div');
    div.className='cli-card';
    div.innerHTML = `
      <div>
        <div class="cli-nome">${c.nome}</div>
        <div class="cli-info">${c.veiculo||'—'}${c.telefone? ' · '+c.telefone:''}</div>
      </div>
      <svg class="cli-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
    `;
    div.addEventListener('click', ()=> openClienteModal(c));
    wrap.appendChild(div);
  });
}

function renderFinanceiro(){
  // receitas automáticas = OS pagas; despesas/receitas manuais = financeiroExtra
  const receitasOS = ordens.filter(o=>o.pago).map(o=>({
    id:'os-'+o.id, tipo:'receita', descricao:'OS · '+clienteNome(o.clienteId), valor: osTotal(o),
    data: o.dataConclusao || o.dataAbertura
  }));
  const todos = [...receitasOS, ...financeiroExtra].sort((a,b)=> (b.data||'').localeCompare(a.data||''));

  const mesReceitas = todos.filter(t=>t.tipo==='receita' && isThisMonth(t.data)).reduce((s,t)=>s+parseFloat(t.valor||0),0);
  const mesDespesas = todos.filter(t=>t.tipo==='despesa' && isThisMonth(t.data)).reduce((s,t)=>s+parseFloat(t.valor||0),0);

  document.getElementById('finReceitas').innerHTML = '<small>R$</small>'+fmtMoney(mesReceitas);
  document.getElementById('finDespesas').innerHTML = '<small>R$</small>'+fmtMoney(mesDespesas);
  document.getElementById('finSaldo').innerHTML = '<small>R$</small>'+fmtMoney(mesReceitas-mesDespesas);

  let list = todos;
  if(finFilter==='rec') list = todos.filter(t=>t.tipo==='receita');
  if(finFilter==='desp') list = todos.filter(t=>t.tipo==='despesa');

  const wrap = document.getElementById('listFinanceiro');
  wrap.innerHTML = '';
  if(list.length===0){
    wrap.innerHTML = emptyState('Nada por aqui', 'Lançamentos de OS pagas aparecem automaticamente.');
    return;
  }
  list.forEach(t=>{
    const div = document.createElement('div');
    div.className='fin-row';
    div.innerHTML = `
      <div>
        <div class="fin-desc">${t.descricao}</div>
        <div class="fin-date">${fmtDate(t.data)}</div>
      </div>
      <div class="fin-val ${t.tipo==='receita'?'rec':'desp'}">${t.tipo==='receita'?'+':'-'} R$ ${fmtMoney(t.valor)}</div>
    `;
    if(t.id.startsWith('os-')===false){
      div.addEventListener('click', ()=>{
        const item = financeiroExtra.find(f=>f.id===t.id);
        if(item) openFinModal(item);
      });
    }
    wrap.appendChild(div);
  });
}

document.getElementById('filtTodos').addEventListener('click', ()=>setFinFilter('todos'));
document.getElementById('filtRec').addEventListener('click', ()=>setFinFilter('rec'));
document.getElementById('filtDesp').addEventListener('click', ()=>setFinFilter('desp'));
function setFinFilter(f){
  finFilter = f;
  document.getElementById('filtTodos').classList.toggle('active', f==='todos');
  document.getElementById('filtRec').classList.toggle('active', f==='rec');
  document.getElementById('filtDesp').classList.toggle('active', f==='desp');
  renderFinanceiro();
}

/* ==================== FAB ==================== */
document.getElementById('fabAdd').addEventListener('click', ()=>{
  if(!db){ toast('Conecte ao Firebase primeiro'); showSetup(); return; }
  if(currentView==='clientes') openClienteModal(null);
  else if(currentView==='financeiro') openFinModal(null);
  else openOSModal(null);
});

/* ==================== MODAL: OS ==================== */
function openOSModal(os){
  const isNew = !os;
  const itensIniciais = os ? (os.itens||[]).map(i=>({...i})) : [{descricao:'', valor:''}];
  let itens = itensIniciais.length? itensIniciais : [{descricao:'', valor:''}];
  let status = os ? os.status : 'aberta';
  let pago = os ? !!os.pago : false;

  const clienteOpts = clientes.map(c=>`<option value="${c.id}" ${os&&os.clienteId===c.id?'selected':''}>${c.nome} ${c.veiculo?'· '+c.veiculo:''}</option>`).join('');

  const html = `
    <div class="overlay" id="ovOS">
      <div class="sheet">
        <div class="sheet-handle"></div>
        <div class="sheet-title">${isNew?'Nova Ordem de Serviço':'Editar OS'}<button class="sheet-close" id="closeOS">✕</button></div>

        <label>Cliente / Veículo</label>
        <select id="osCliente">
          <option value="">${clientes.length? 'Selecione um cliente':'Cadastre um cliente primeiro'}</option>
          ${clienteOpts}
        </select>

        <label>Descrição do serviço</label>
        <textarea id="osDesc" placeholder="Ex: Troca de óleo e filtro, revisão de freios...">${os?os.descricao||'':''}</textarea>

        <label>Itens (peças / serviços)</label>
        <div id="osItens"></div>
        <button type="button" class="add-item-btn" id="osAddItem">+ Adicionar item</button>

        <div class="total-line"><span>Total</span><span id="osTotalLabel">R$ 0,00</span></div>

        <label>Status</label>
        <div class="status-picker" id="osStatusPicker">
          ${['aberta','andamento','concluida','entregue'].map(s=>`<div class="status-opt ${status===s?'sel':''}" data-s="${s}">${statusLabel(s)}</div>`).join('')}
        </div>

        <label>Pagamento</label>
        <div class="pay-toggle">
          <div class="pay-opt ${pago?'sel-yes':''}" id="osPagoSim">Pago</div>
          <div class="pay-opt ${!pago?'sel-no':''}" id="osPagoNao">Pendente</div>
        </div>

        <button class="btn-primary" id="osSalvar">${isNew?'Criar OS':'Salvar alterações'}</button>
        ${!isNew? '<button class="btn-secondary btn-danger" id="osExcluir">Excluir OS</button>':''}
      </div>
    </div>
  `;
  document.getElementById('modalRoot').innerHTML = html;

  function renderItens(){
    const wrap = document.getElementById('osItens');
    wrap.innerHTML = '';
    itens.forEach((it,idx)=>{
      const row = document.createElement('div');
      row.className='item-line';
      row.innerHTML = `
        <input type="text" placeholder="Descrição" value="${it.descricao||''}" data-idx="${idx}" data-f="descricao">
        <input type="number" inputmode="decimal" class="val" placeholder="R$ 0,00" value="${it.valor||''}" data-idx="${idx}" data-f="valor">
        <button type="button" class="item-del" data-idx="${idx}">✕</button>
      `;
      wrap.appendChild(row);
    });
    wrap.querySelectorAll('input').forEach(inp=>{
      inp.addEventListener('input', e=>{
        const idx = +e.target.dataset.idx, f = e.target.dataset.f;
        itens[idx][f] = e.target.value;
        updateTotal();
      });
    });
    wrap.querySelectorAll('.item-del').forEach(btn=>{
      btn.addEventListener('click', e=>{
        const idx = +e.target.dataset.idx;
        itens.splice(idx,1);
        if(itens.length===0) itens.push({descricao:'',valor:''});
        renderItens(); updateTotal();
      });
    });
  }
  function updateTotal(){
    const t = itens.reduce((s,i)=>s+(parseFloat(i.valor)||0),0);
    document.getElementById('osTotalLabel').textContent = 'R$ ' + fmtMoney(t);
  }
  renderItens(); updateTotal();

  document.getElementById('osAddItem').addEventListener('click', ()=>{
    itens.push({descricao:'',valor:''});
    renderItens(); updateTotal();
  });

  document.querySelectorAll('#osStatusPicker .status-opt').forEach(el=>{
    el.addEventListener('click', ()=>{
      status = el.dataset.s;
      document.querySelectorAll('#osStatusPicker .status-opt').forEach(o=>o.classList.remove('sel'));
      el.classList.add('sel');
    });
  });
  document.getElementById('osPagoSim').addEventListener('click', ()=>{
    pago = true;
    document.getElementById('osPagoSim').classList.add('sel-yes');
    document.getElementById('osPagoNao').classList.remove('sel-no');
  });
  document.getElementById('osPagoNao').addEventListener('click', ()=>{
    pago = false;
    document.getElementById('osPagoNao').classList.add('sel-no');
    document.getElementById('osPagoSim').classList.remove('sel-yes');
  });

  document.getElementById('closeOS').addEventListener('click', closeModal);
  document.getElementById('ovOS').addEventListener('click', e=>{ if(e.target.id==='ovOS') closeModal(); });

  document.getElementById('osSalvar').addEventListener('click', ()=>{
    const clienteId = document.getElementById('osCliente').value;
    if(!clienteId){ toast('Selecione um cliente'); return; }
    const descricao = document.getElementById('osDesc').value.trim();
    const itensLimpos = itens.filter(i=>i.descricao||i.valor).map(i=>({descricao:i.descricao||'', valor: parseFloat(i.valor)||0}));

    const data = {
      clienteId, descricao, itens: itensLimpos.length?itensLimpos:[{descricao:'Serviço', valor:0}],
      status, pago,
      dataAbertura: os? os.dataAbertura : todayISO(),
      dataConclusao: (status==='concluida'||status==='entregue') ? (os&&os.dataConclusao?os.dataConclusao:todayISO()) : (os?os.dataConclusao||null:null)
    };

    if(isNew){
      baseCol('ordens').add(data).then(()=>{ toast('OS criada'); closeModal(); }).catch(()=>toast('Erro ao salvar'));
    } else {
      baseCol('ordens').doc(os.id).update(data).then(()=>{ toast('OS atualizada'); closeModal(); }).catch(()=>toast('Erro ao salvar'));
    }
  });

  if(!isNew){
    document.getElementById('osExcluir').addEventListener('click', ()=>{
      if(confirm('Excluir esta ordem de serviço?')){
        baseCol('ordens').doc(os.id).delete().then(()=>{ toast('OS excluída'); closeModal(); });
      }
    });
  }
}

/* ==================== MODAL: Cliente ==================== */
function openClienteModal(c){
  const isNew = !c;
  const html = `
    <div class="overlay" id="ovCli">
      <div class="sheet">
        <div class="sheet-handle"></div>
        <div class="sheet-title">${isNew?'Novo Cliente':'Editar Cliente'}<button class="sheet-close" id="closeCli">✕</button></div>

        <label>Nome</label>
        <input id="cliNome" placeholder="Nome do cliente" value="${c?c.nome||'':''}">

        <label>Telefone</label>
        <input id="cliTel" placeholder="(00) 00000-0000" value="${c?c.telefone||'':''}">

        <label>Veículo / Equipamento</label>
        <input id="cliVeic" placeholder="Ex: Fiat Uno 2015 - ABC1D23" value="${c?c.veiculo||'':''}">

        <label>Observações</label>
        <textarea id="cliObs" placeholder="Anotações sobre o cliente ou veículo">${c?c.obs||'':''}</textarea>

        <button class="btn-primary" id="cliSalvar">${isNew?'Cadastrar':'Salvar alterações'}</button>
        ${!isNew? '<button class="btn-secondary btn-danger" id="cliExcluir">Excluir cliente</button>':''}
      </div>
    </div>
  `;
  document.getElementById('modalRoot').innerHTML = html;
  document.getElementById('closeCli').addEventListener('click', closeModal);
  document.getElementById('ovCli').addEventListener('click', e=>{ if(e.target.id==='ovCli') closeModal(); });

  document.getElementById('cliSalvar').addEventListener('click', ()=>{
    const nome = document.getElementById('cliNome').value.trim();
    if(!nome){ toast('Informe o nome'); return; }
    const data = {
      nome,
      telefone: document.getElementById('cliTel').value.trim(),
      veiculo: document.getElementById('cliVeic').value.trim(),
      obs: document.getElementById('cliObs').value.trim()
    };
    if(isNew){
      baseCol('clientes').add(data).then(()=>{ toast('Cliente cadastrado'); closeModal(); });
    } else {
      baseCol('clientes').doc(c.id).update(data).then(()=>{ toast('Cliente atualizado'); closeModal(); });
    }
  });

  if(!isNew){
    document.getElementById('cliExcluir').addEventListener('click', ()=>{
      const temOS = ordens.some(o=>o.clienteId===c.id);
      if(temOS){ toast('Cliente tem OS vinculadas — não é possível excluir'); return; }
      if(confirm('Excluir este cliente?')){
        baseCol('clientes').doc(c.id).delete().then(()=>{ toast('Cliente excluído'); closeModal(); });
      }
    });
  }
}

/* ==================== MODAL: Financeiro (manual) ==================== */
function openFinModal(item){
  const isNew = !item;
  let tipo = item? item.tipo : 'despesa';
  const html = `
    <div class="overlay" id="ovFin">
      <div class="sheet">
        <div class="sheet-handle"></div>
        <div class="sheet-title">${isNew?'Novo Lançamento':'Editar Lançamento'}<button class="sheet-close" id="closeFin">✕</button></div>

        <label>Tipo</label>
        <div class="pay-toggle">
          <div class="pay-opt ${tipo==='receita'?'sel-yes':''}" id="finRecOpt">Receita</div>
          <div class="pay-opt ${tipo==='despesa'?'sel-no':''}" id="finDespOpt">Despesa</div>
        </div>

        <label>Descrição</label>
        <input id="finDesc" placeholder="Ex: Aluguel, compra de peças, venda avulsa..." value="${item?item.descricao||'':''}">

        <div class="row2">
          <div>
            <label>Valor (R$)</label>
            <input id="finValor" type="number" inputmode="decimal" placeholder="0,00" value="${item?item.valor||'':''}">
          </div>
          <div>
            <label>Data</label>
            <input id="finData" type="date" value="${item?item.data||todayISO():todayISO()}">
          </div>
        </div>

        <button class="btn-primary" id="finSalvar">${isNew?'Adicionar':'Salvar alterações'}</button>
        ${!isNew? '<button class="btn-secondary btn-danger" id="finExcluir">Excluir lançamento</button>':''}
      </div>
    </div>
  `;
  document.getElementById('modalRoot').innerHTML = html;
  document.getElementById('closeFin').addEventListener('click', closeModal);
  document.getElementById('ovFin').addEventListener('click', e=>{ if(e.target.id==='ovFin') closeModal(); });

  document.getElementById('finRecOpt').addEventListener('click', ()=>{
    tipo='receita';
    document.getElementById('finRecOpt').classList.add('sel-yes');
    document.getElementById('finDespOpt').classList.remove('sel-no');
  });
  document.getElementById('finDespOpt').addEventListener('click', ()=>{
    tipo='despesa';
    document.getElementById('finDespOpt').classList.add('sel-no');
    document.getElementById('finRecOpt').classList.remove('sel-yes');
  });

  document.getElementById('finSalvar').addEventListener('click', ()=>{
    const descricao = document.getElementById('finDesc').value.trim();
    const valor = parseFloat(document.getElementById('finValor').value);
    const data = document.getElementById('finData').value || todayISO();
    if(!descricao || !valor){ toast('Preencha descrição e valor'); return; }
    const payload = { tipo, descricao, valor, data };
    if(isNew){
      baseCol('financeiro').add(payload).then(()=>{ toast('Lançamento salvo'); closeModal(); });
    } else {
      baseCol('financeiro').doc(item.id).update(payload).then(()=>{ toast('Lançamento atualizado'); closeModal(); });
    }
  });

  if(!isNew){
    document.getElementById('finExcluir').addEventListener('click', ()=>{
      if(confirm('Excluir este lançamento?')){
        baseCol('financeiro').doc(item.id).delete().then(()=>{ toast('Lançamento excluído'); closeModal(); });
      }
    });
  }
}

function closeModal(){ document.getElementById('modalRoot').innerHTML=''; }

/* ==================== INIT ==================== */
tryConnect();
